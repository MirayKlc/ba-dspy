{
  "programm.find_evidence": {
    "traces": [],
    "train": [],
    "demos": [],
    "signature": {
      "instructions": "Find the paragraphs needed to answer the question and quote the sentences that matter.",
      "fields": [
        {
          "prefix": "Question:",
          "description": "${question}"
        },
        {
          "prefix": "Paragraphs:",
          "description": "ten paragraphs, only a few of them are relevant"
        },
        {
          "prefix": "Relevant Titles:",
          "description": "titles of the paragraphs that are needed to answer the question"
        },
        {
          "prefix": "Relevant Text:",
          "description": "the sentences from those paragraphs that are needed, quoted verbatim"
        }
      ]
    },
    "lm": {
      "_dspy_lm_class": "dspy.clients.lm.LM",
      "model": "openrouter/google/gemma-4-31b-it",
      "model_type": "chat",
      "cache": false,
      "num_retries": 10,
      "temperature": 0.0,
      "max_tokens": 1000,
      "extra_body": {
        "provider": {
          "only": [
            "deepinfra/turbo"
          ],
          "allow_fallbacks": false
        },
        "reasoning": {
          "enabled": false
        }
      },
      "finetuning_model": null,
      "launch_kwargs": {},
      "train_kwargs": {}
    }
  },
  "programm.answer_question": {
    "traces": [],
    "train": [],
    "demos": [],
    "signature": {
      "instructions": "Answer the question using only the given sentences. Reply with a short phrase.",
      "fields": [
        {
          "prefix": "Question:",
          "description": "${question}"
        },
        {
          "prefix": "Relevant Text:",
          "description": "the sentences that were found to be relevant"
        },
        {
          "prefix": "Answer:",
          "description": "a short phrase, not a sentence"
        }
      ]
    },
    "lm": {
      "_dspy_lm_class": "dspy.clients.lm.LM",
      "model": "openrouter/google/gemma-4-31b-it",
      "model_type": "chat",
      "cache": false,
      "num_retries": 10,
      "temperature": 0.0,
      "max_tokens": 1000,
      "extra_body": {
        "provider": {
          "only": [
            "deepinfra/turbo"
          ],
          "allow_fallbacks": false
        },
        "reasoning": {
          "enabled": false
        }
      },
      "finetuning_model": null,
      "launch_kwargs": {},
      "train_kwargs": {}
    }
  },
  "metadata": {
    "dependency_versions": {
      "python": "3.13",
      "dspy": "3.3.1",
      "cloudpickle": "3.1"
    }
  }
}
